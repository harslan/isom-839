---
import '../assets/styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Footer from '../components/Footer.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  navBrand?: string;
}

const { title, description, navBrand } = Astro.props;

const siteLinks: { label: string; href: string; accent?: 'graduate' }[] = [
  { label: 'Home', href: '/' },
  { label: 'Sessions', href: '/sessions' },
  { label: 'Syllabus', href: '/syllabus' },
  { label: 'Deadlines', href: '/deadlines' },
  { label: 'Resources', href: '/resources' },
  { label: 'Explorers', href: '/explorers' },
  { label: 'Studio', href: '/deep-learning-studio' },
  { label: 'Project', href: '/project' },
  { label: 'Practice', href: '/practice' },
];

// Build search index
const sessions = await getCollection('sessions');
const sorted = sessions.sort((a, b) => a.data.number - b.data.number);

const searchIndex: { type: string; title: string; subtitle?: string; url: string; tags?: string[]; sessionTitle?: string }[] = [];

for (const session of sorted) {
  const d = session.data;
  const url = `/sessions/${d.slug}`;
  const numStr = String(d.number).padStart(2, '0');
  const sessionLabel = `Session ${numStr}`;

  searchIndex.push({
    type: 'session',
    title: `${sessionLabel}: ${d.title}`,
    subtitle: d.subtitle,
    url,
    tags: d.tags,
  });

  for (const obj of d.objectives || []) {
    searchIndex.push({
      type: 'objective',
      title: obj.title,
      subtitle: obj.description,
      url: `${url}#objectives`,
      sessionTitle: sessionLabel,
    });
  }

  for (const res of d.resources || []) {
    searchIndex.push({
      type: 'resource',
      title: res.title,
      subtitle: res.description,
      url: res.url,
      sessionTitle: sessionLabel,
    });
  }
}

searchIndex.push({
  type: 'explorer',
  title: 'Explorers — interactive optimization',
  subtitle: 'Bakery LP, network flow, branch & bound, efficient frontier',
  url: '/explorers',
});

searchIndex.push({
  type: 'explorer',
  title: 'Deep Learning Studio — build five neural networks',
  subtitle: 'Colab notebooks for classification, regression, pictures, music and video, plus the One Recipe, Five Senses slides',
  url: '/deep-learning-studio',
});

searchIndex.push({
  type: 'explorer',
  title: 'Colab: Attention by hand, and a baby TabICL',
  subtitle: 'Compute attention in six lines, then train a tiny in-context learner on made-up tables',
  url: 'https://colab.research.google.com/github/harslan/isom-839/blob/master/public/deep-learning-studio/DL_Studio_Go_Deeper_Attention_and_Baby_TabICL.ipynb',
});

searchIndex.push({
  type: 'explorer',
  title: 'Transformers and TabICL, in plain English',
  subtitle: 'Slides: attention, how a transformer works, and how TabICL reads a table in three stages',
  url: '/deep-learning-studio/transformers-tabicl.html',
});

searchIndex.push({
  type: 'practice',
  title: 'Practice — Optimization question bank',
  subtitle: '27 exam-style LP questions with misconception-tagged answers',
  url: '/practice',
});

searchIndex.push({
  type: 'project',
  title: 'Your Optimization Story — Final Project',
  subtitle: 'Pick a real decision. Model it. Solve it. Present Dec 16.',
  url: '/project',
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} />
</head>
<body>
  <NeuralBackground />
  <Navbar brand={navBrand} links={siteLinks} />
  <MobileMenu links={siteLinks} />
  <SearchDialog searchIndex={searchIndex} />
  <main class="pt-[72px]">
    <slot />
  </main>
  <Footer />

  <script is:inline>
    // Fade-in observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  </script>
</body>
</html>
