---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientText from '../components/GradientText.astro';
import ResourceCard from '../components/ResourceCard.astro';
import ResourceGrid from '../components/ResourceGrid.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const sessions = await getCollection('sessions');
const sorted = sessions.sort((a, b) => a.data.number - b.data.number);

// Deduplicate resources by URL
const seen = new Set<string>();
const allResources: { resource: any; sessionNumber: number }[] = [];
for (const session of sorted) {
  for (const res of session.data.resources || []) {
    if (!seen.has(res.url)) {
      seen.add(res.url);
      allResources.push({ resource: res, sessionNumber: session.data.number });
    }
  }
}
---

<BaseLayout title="ISOM 839 | Resources">
  <section class="py-24 px-8 max-w-[1200px] mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold mb-4">
        <GradientText>Resources</GradientText> Hub
      </h1>
      <p class="text-text-secondary text-lg max-w-[600px] mx-auto">
        All tools, videos, and learning materials from every session — deduplicated and organized.
      </p>
    </div>

    <a href="/deep-learning-studio" class="group flex flex-wrap items-center justify-between gap-4 bg-gradient-to-br from-accent-purple/[0.08] to-bg-card border border-accent-purple/30 rounded-2xl px-7 py-5 no-underline mb-10 transition-all duration-300 hover:border-accent-purple/60">
      <div class="min-w-0">
        <span class="font-mono text-[0.7rem] tracking-[2px] uppercase text-accent-purple">Featured · Deep Learning Studio</span>
        <span class="block text-text-primary font-semibold mt-1">Five build-it-yourself Colab notebooks and the "One Recipe, Five Senses" slides</span>
      </div>
      <span class="font-mono text-[0.8rem] tracking-wide text-accent-purple whitespace-nowrap transition-transform duration-300 group-hover:translate-x-1">Open the Studio →</span>
    </a>

    {allResources.length > 0 ? (
      <ResourceGrid>
        {allResources.map(({ resource }) => (
          <ResourceCard
            title={resource.title}
            url={resource.url}
            description={resource.description}
            icon={resource.icon}
            badge={resource.badge}
            badgeType={resource.badgeType}
            linkText={resource.linkText}
          />
        ))}
      </ResourceGrid>
    ) : (
      <div class="text-center py-24">
        <Icon name="inbox" class="w-16 h-16 text-text-muted mx-auto mb-4" />
        <p class="text-text-secondary text-lg">Resources will appear here as sessions are published.</p>
      </div>
    )}

  </section>
</BaseLayout>
